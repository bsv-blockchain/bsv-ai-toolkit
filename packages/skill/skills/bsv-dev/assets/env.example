# bsv-dev app settings. Copy to .env and adjust. This file holds no signing material, ever.

# testnet or mainnet. Unset means testnet; set mainnet only on purpose, in the deployed environment.
BSV_NETWORK=testnet

# Arcade base URL. Empty = the public instance for BSV_NETWORK.
ARCADE_URL=

# Optional WhatsOnChain API token, sent as the raw Authorization header value. Empty = free tier.
WOC_API_KEY=

# The app's public origin, where public/manifest.json is served; the WalletClient originator is its host.
PUBLIC_ORIGIN=http://localhost:5173

# Fee rate in sat/kB for sizing fees from the serialized draft; never below what Arcade's GET /policy reports.
FEE_SAT_PER_KB=100
