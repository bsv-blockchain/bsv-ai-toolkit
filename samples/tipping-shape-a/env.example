# bsv-tipping-demo relay settings. Copy to .env and adjust; pnpm dev and pnpm start read it (a variable set in
# the shell wins), and docker-compose.yml passes it to the container. This file holds no signing material, ever:
# the relay holds no key and signs nothing; tippers and the creator sign in their own wallets.
# The values below suit local development; HOSTING.md says what to set on a public host.

# testnet or mainnet. Unset means testnet; set mainnet only on purpose, in the deployed environment.
BSV_NETWORK=testnet

# Arcade base URL. Empty = the public instance for BSV_NETWORK.
ARCADE_URL=

# The app's public origin, where /manifest.json, the app and /api are served; it is the wallet originator.
# On a host, set the exact https:// origin people open, e.g. https://tipping.example.com: the image runs with
# NODE_ENV=production, which refuses an empty, http: or localhost/127.0.0.1 origin. Empty in development means
# http://localhost:5173 (pnpm dev); set http://localhost:8080 for pnpm start.
PUBLIC_ORIGIN=

# Relay port. Default 8080. docker-compose.yml pins it to 8080 inside the container.
PORT=8080

# Where the SQLite file tips.sqlite lives. Default ./data. docker-compose.yml pins it to the /data volume.
DATA_DIR=./data

# The creator's identity public key (33-byte compressed, hex). Required on mainnet. Empty (testnet only) =
# the first wallet that claims the creator page, signing the claim with this key, becomes the creator, and
# that choice is persisted. Set it on any public host.
CREATOR_IDENTITY_KEY=

# Which peers may set X-Forwarded-For, so the relay sees each client's address (rate limits). Empty = loopback,
# link-local and private-network peers (a proxy on this host or in this compose network). Otherwise a proxy
# address or subnet list, a hop count, or false when nothing sits in front of the relay.
TRUST_PROXY=
