# bsv-tipping-demo relay settings. Copy to .env and adjust. This file holds no signing material, ever:
# the relay holds no key and signs nothing; tippers and the creator sign in their own wallets.

# testnet or mainnet. Unset means testnet; set mainnet only on purpose, in the deployed environment.
BSV_NETWORK=testnet

# Arcade base URL. Empty = the public instance for BSV_NETWORK.
ARCADE_URL=

# The app's public origin, where /manifest.json, the app and /api are served; it is the wallet originator.
# Required when NODE_ENV=production. Unset in development means http://localhost:5173 (pnpm dev).
PUBLIC_ORIGIN=http://localhost:5173

# Relay port. Default 8080.
PORT=8080

# Where the SQLite file tips.sqlite lives. Default ./data.
DATA_DIR=./data

# The creator's identity public key (33-byte compressed, hex). Required on mainnet. Empty (testnet only) =
# the first wallet that claims the creator page, signing the claim with this key, becomes the creator, and
# that choice is persisted.
CREATOR_IDENTITY_KEY=

# Which peers may set X-Forwarded-For, so the relay sees each client's address (rate limits). Empty = loopback,
# link-local and private-network peers (a proxy on this host or in this compose network). Otherwise a proxy
# address or subnet list, a hop count, or false when nothing sits in front of the relay.
TRUST_PROXY=
