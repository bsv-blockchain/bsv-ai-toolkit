{
  "name": "bsv-tipping-demo",
  "version": "0.1.0",
  "private": true,
  "description": "BSV tipping demo: a shape-A web app (the user's wallet holds the keys) with a key-less relay on one origin",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "public",
    "scripts/network-guard.sh"
  ],
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "concurrently -n web,relay \"vite\" \"tsx watch --env-file-if-exists=.env server/index.ts\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env -e \"process.exit(require('node:child_process').spawnSync('bash', ['scripts/network-guard.sh'], { stdio: 'inherit' }).status ?? 1)\" && node --env-file-if-exists=.env dist/server/index.js",
    "test": "vitest run",
    "gate": "tsx scripts/gate.ts",
    "guardrails": "node ../../packages/mcp/build/cli/check-guardrails.js ."
  },
  "dependencies": {
    "@bsv/sdk": "3.2.1",
    "better-sqlite3": "^13.0.3",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@bsv/wallet-toolbox": "2.14.9",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8",
    "vite": "^7.0.0",
    "vitest": "^4"
  }
}
