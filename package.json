{
  "name": "bsv-ai-devkit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "sync": "pnpm -F @bsv/sync sync",
    "sync:check": "pnpm -F @bsv/sync sync:check",
    "check:facts": "pnpm -F @bsv/sync check:facts",
    "check:links": "pnpm -F @bsv/sync check:links"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.8",
    "vitest": "^4"
  }
}
